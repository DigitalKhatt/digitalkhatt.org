{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "es2020",
    "allowJs": true,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@digitalkhatt/quran-engine": ["../packages/quran-engine/src/index.ts"],
      "@digitalkhatt/quran-engine/*": ["../packages/quran-engine/src/*"]
    }
  }
}

