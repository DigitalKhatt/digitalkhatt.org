{
  "name": "digitalkhatt-textmode",
  "private": true,
  "description": "Justified Madina pages as real, selectable HTML text: per-letter stretching replayed by position features (jpNN) added to the fonts.",
  "type": "module",
  "scripts": {
    "bundle": "node build.mjs",
    "collect": "npm run bundle && node dist/collect.mjs",
    "verify": "npm run bundle && node dist/verify.mjs",
    "browser-check": "npm run bundle && node dist/browser-check.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "harfbuzzjs": "0.4.5",
    "lz-string": "1.5.0",
    "playwright": "^1.55.0"
  }
}
